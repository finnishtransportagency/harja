;;; Oikeusmatriisi: osio -> näkymä -> rooli -> oikeudet
;;;
;;; Oikeuskoodit:
;;;   R  = lukuoikeus omiin urakoihin
;;;   R* = lukuoikeus kaikkiin urakoihin
;;;   W  = kirjoitusoikeus omiin urakoihin
