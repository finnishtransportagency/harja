{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/talvihoitoreitti-poisto-request",
  "type": "object",
  "additionalProperties": false,
  "description": "Poistaa talvihoitoreitit ulkoisen-id:n perusteella. Listaa kaikki poistettavat talvihoitoreitit arrayna.",
  "properties": {
    "talvihoitoreittien-tunnisteet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["talvihoitoreittien-tunnisteet"]
}
