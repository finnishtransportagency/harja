{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/reikapaikkaus",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tunniste": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
    },
    "pvm": {
      "type": "string",
      "format": "date"
    },
    "sijainti": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reikäpaikkauskohteen sijainti. Anna joko tieosoite, pistegeometria tai viivageometria.",
      "properties": {
        "tieosoite": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/tieosoitevali-tienkohdilla.schema.json"
        },
        "pistegeometria": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/koordinaattisijainti.schema.json"
        },
        "viivageometria": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/viivageometriasijainti.schema.json"
        }
      }
    },
    "tyomenetelma": {
      "enum": [
        "REPA",
        "KTVA",
        "SIPU",
        "SIPA",
        "HJYR/TJYR",
        "Käsin tehtävät paikkaukset pikapaikkausmassalla",
        "AB-paikkaus käsin",
        "PAB-paikkaus käsin",
        "Muu päällysteiden paikkaustyö"
      ]
    },
    "maara": {
      "type": "number",
      "description": "Yksikön mukainen määrä. Esim tonnia: 1.23"
    },
    "yksikko": {
      "type": "string",
      "description": "Yksikön nimi. Esim tonnia: t"
    },
    "kustannus": {
      "type": "number",
      "description": "Kustannus euroina. Esim 45534.23"
    }
  },
  "required": [
    "tunniste",
    "pvm",
    "sijainti",
    "tyomenetelma",
    "maara",
    "yksikko",
    "kustannus"
  ]
}
