{
  "$schema": "http://json-schema.org/draft-03/schema#",
  "id": "urn:harja",
  "type": "object",
  "additionalProperties": false,
  "required": true,
  "properties": {
    "tunniste": {
      "id": "urn:harja/reikapaikkaukset/0/reikapaikkaus/tunniste",
      "required": true,
      "additionalProperties": false,
      "type": "object",
      "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
    },
    "pvm": {
      "id": "urn:harja/reikapaikkaukset/0/reikapaikkaus/pvm",
      "type": [
        "string"
      ],
      "format": "date",
      "required": true
    },
    "sijainti": {
      "id": "urn:harja/reikapaikkaukset/0/reikapaikkaus/sijainti",
      "type": "object",
      "additionalProperties": false,
      "required": true,
      "description": "Reikäpaikkauskohteen sijainti. Anna joko tieosoite, pistegeometria tai viivageometria.",
      "properties": {
        "tieosoite": {
          "id": "urn:harja/yllapitokohdeosat/0/yllapitokohdeosa/sijainti",
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/paaluvali.schema.json"
        },
        "pistegeometria": {
          "id": "urn:harja/reitti/0/koordinaattisijainti",
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/koordinaattisijainti.schema.json",
          "required": false
        },
        "viivageometria": {
          "id": "urn:harja/viivageometria",
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/viivageometriasijainti.schema.json"
        }
      }
    },
    "tyomenetelma": {
      "id": "urn:harja/reikapaikkaukset/0/reikapaikkaus/tyomenetelma",
      "required": true,
      "enum": [
        "REPA",
        "KTVA",
        "SIPU",
        "SIPA",
        "HJYR/TJYR",
        "Käsin tehtävät paikkaukset pikapaikkausmassalla",
        "AB-paikkaus käsin",
        "PAB-paikkaus käsin",
        "Muu päällysteiden paikkaustyö"
      ]
    },
    "maara": {
      "id": "urn:harja/reikapaikkaukset/0/reikapaikkaus/maara",
      "type": "number",
      "required": true,
      "description": "Yksikön mukainen määrä. Esim tonnia: 1.23"
    },
    "yksikko": {
      "id": "urn:harja/reikapaikkaukset/0/reikapaikkaus/yksikko",
      "type": "string",
      "required": true,
      "description": "Yksikön nimi. Esim tonnia: t"
    },
    "kustannus": {
      "id": "urn:harja/reikapaikkaukset/0/reikapaikkaus/kustannus",
      "type": "number",
      "required": true,
      "description": "Kustannus euroina. Esim 45534.23"
    }
  }
}
