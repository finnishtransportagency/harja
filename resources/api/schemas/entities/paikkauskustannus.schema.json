{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/paikkauskustannus",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tunniste": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
    },
    "paikkauskohde": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nimi": {
          "type": "string"
        },
        "tunniste": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
        }
      },
      "required": [
        "nimi",
        "tunniste"
      ]
    },
    "kirjausaika": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "kokonaishintaiset-kustannukset": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kokonaishintainen-kustannus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "selite": {
                "type": "string"
              },
              "hinta": {
                "type": "number"
              }
            },
            "required": [
              "selite",
              "hinta"
            ]
          }
        },
        "required": [
          "kokonaishintainen-kustannus"
        ]
      }
    },
    "yksikkohintaiset-kustannukset": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "yksikkohintainen-kustannus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "selite": {
                "type": "string"
              },
              "yksikko": {
                "type": "string"
              },
              "yksikkohinta": {
                "type": "number"
              },
              "maara": {
                "type": "number"
              }
            },
            "required": [
              "selite",
              "yksikko",
              "yksikkohinta",
              "maara"
            ]
          }
        },
        "required": [
          "yksikkohintainen-kustannus"
        ]
      }
    }
  },
  "required": [
    "tunniste",
    "paikkauskohde",
    "kirjausaika",
    "kokonaishintaiset-kustannukset",
    "yksikkohintaiset-kustannukset"
  ]
}
