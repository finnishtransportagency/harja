{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/paikkaus",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tunniste": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
    },
    "paikkauskohde": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nimi": {
          "type": "string"
        },
        "tunniste": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
        }
      },
      "required": [
        "nimi",
        "tunniste"
      ]
    },
    "alkuaika": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "loppuaika": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sijainti": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tieosoitevali-tienkohdilla.schema.json"
    },
    "tyomenetelma": {
      "type": "string",
      "enum": [
        "MPA",
        "HJYR",
        "KTVA",
        "REPA",
        "SIPA",
        "SIPU",
        "UREM"
      ]
    },
    "massatyyppi": {
      "type": "string",
      "enum": [
        "AB, Asfalttibetoni",
        "SMA, Kivimastiksiasfaltti",
        "PAB-B, Pehmeät asfalttibetonit",
        "PAB-V, Pehmeät asfalttibetonit",
        "PAB-O, Pehmeät asfalttibetonit",
        "VA, valuasfaltti",
        "SIP, Sirotepintaus",
        "SOP, Soratien pintaus"
      ]
    },
    "leveys": {
      "type": "number"
    },
    "massamenekki": {
      "type": "integer",
      "description": "Poistumassa käytöstä, massamäärä korvaa tämän. Käytössä siihen asti, että rajapinnan käyttäjät ottavat massamäärän käyttöön."
    },
    "massamaara": {
      "type": "integer",
      "description": "Massamäärä kilogrammoina. Vapaaehtoinen kunnes massamenekki poistetaan käytöstä."
    },
    "raekoko": {
      "$ref": "file:resources/api/schemas/entities/paallystys_raekoko.schema.json"
    },
    "kuulamylly": {
      "type": "string",
      "enum": [
        "AN5",
        "AN7",
        "AN10",
        "AN14",
        "AN19",
        "AN30"
      ]
    },
    "kivi-ja-sideaineet": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kivi-ja-sideaine": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "esiintyma": {
                "type": "string"
              },
              "km-arvo": {
                "type": "string"
              },
              "muotoarvo": {
                "type": "string"
              },
              "sideainetyyppi": {
                "type": "string",
                "enum": [
                  "20/30",
                  "35/50",
                  "50/70",
                  "70/100",
                  "100/150",
                  "160/220",
                  "250/330",
                  "330/430",
                  "500/650",
                  "650/900",
                  "V1500",
                  "V3000",
                  "KB65",
                  "KB75",
                  "KB85",
                  "BL5",
                  "BL2K",
                  "BL2 Bio",
                  "BE-L",
                  "BE-SIP",
                  "BE-SOP",
                  "BE-PAB"
                ]
              },
              "pitoisuus": {
                "type": "number"
              },
              "lisa-aineet": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "tunniste",
    "paikkauskohde",
    "alkuaika",
    "loppuaika",
    "sijainti",
    "tyomenetelma",
    "massatyyppi"
  ]
}
