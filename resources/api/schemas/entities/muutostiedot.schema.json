{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/muutostiedot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "luotu": {
      "type": "string",
      "format": "date-time"
    },
    "luoja": {
      "type": "string",
      "format": "date-time"
    },
    "muokattu": {
      "type": "string",
      "format": "date-time"
    },
    "muokkaaja": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["luotu", "luoja"]
}
