{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/urakka",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "urakka": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tiedot": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/urakka-otsikko.schema.json"
        },
        "sopimukset": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sopimus": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "nimi": {
                    "type": "string"
                  },
                  "alkupvm": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "loppupvm": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "paasopimusId": {
                    "type": "integer"
                  }
                },
                "required": ["id", "nimi"]
              }
            }
          }
        },
        "materiaalit": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "materiaali": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "nimi": {
                    "type": "string"
                  },
                  "yksikko": {
                    "type": "string"
                  }
                },
                "required": ["nimi", "yksikko"]
              }
            }
          }
        },
        "tehtavat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kokonaishintaiset": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tehtava": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "selite": {
                        "type": "string"
                      },
                      "yksikko": {
                        "type": "string"
                      }
                    },
                    "required": ["id"]
                  }
                },
                "required": ["tehtava"]
              }
            },
            "yksikkohintaiset": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tehtava": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "selite": {
                        "type": "string"
                      },
                      "yksikko": {
                        "type": "string"
                      }
                    },
                    "required": ["id", "yksikko"]
                  }
                },
                "required": ["tehtava"]
              }
            }
          }
        }
      },
      "required": ["tiedot"]
    }
  }
}
