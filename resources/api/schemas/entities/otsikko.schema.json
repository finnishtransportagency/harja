{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/otsikko",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "lahettaja": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jarjestelma": {
          "type": "string"
        },
        "organisaatio": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/organisaatio.schema.json"
        }
      },
      "required": ["jarjestelma", "organisaatio"]
    },
    "viestintunniste": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
    },
    "lahetysaika": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["lahettaja", "viestintunniste", "lahetysaika"]
}
