{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/toimenpidekuittaus",
  "type": "object",
  "properties": {
    "kuitattu": {
      "type": "string",
      "format": "date-time"
    },
    "kuittaustyyppi": {
      "enum": [
        "vastaanotto",
        "lopetus",
        "vastaus",
        "muutos",
        "aloitus",
        "valitys",
        "vaara-urakka"
      ]
    },
    "vakiofraasi": {
      "type": "string"
    },
    "vapaateksti": {
      "type": "string"
    },
    "kuittaaja": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/henkilo-opt.schema.json"
    },
    "kuittaajaorganisaatio": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/organisaatio.schema.json"
    }
  },
  "required": ["kuitattu", "kuittaustyyppi", "vakiofraasi", "vapaateksti"]
}
