{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:harja/tyomaapaivakirja-kirjaus",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "tunniste": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "Päiväkirjan sivun id urakoitsijan järjestelmässä",
                    "type": "string"
                },
                "versio": {
                    "description": "Päiväkirjan versionumero urakoitsijan järjestelmästä, alkaa numerosta 1...n. Nostetaan yhdellä ylöspäin jokaisella päivityskerralla. Tätä ei tarvitse antaa, sillä HARJA nostaa versionumeron automaattisesti, mikäli sitä ei ole annettu.",
                    "type": "integer"
                },
                "paivamaara": {
                    "description": "Työmaapäiväkirjan päivä, jolta päiväkirja on tehty.",
                    "type": "string",
                    "format": "date"
                }
            },
            "required": ["id", "paivamaara"]
        },
        "saatiedot": {
            "type": "array",
            "minItems": 1,
            "description": "Yleiskuvaus automaattisesti järjestelmistä (Tiesää) klo 2, 8, 14 ja 22 (sateen sadanta kumulatiivinen, ilman- ja tien lämpötila, tuuli) valitulta/valituilta tiesääasemilta (maksimi 5 kpl). Työmaapäiväkirjaan lasketaan kumulatiivinen sadanta kello 00:00 – 24:00 väliseltä ajalta.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "saatieto": {
                        "type": "object",
                        "properties": {
                            "havaintoaika": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "aseman-tunniste": {
                                "type": "string"
                            },
                            "aseman-tietojen-paivityshetki": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "ilman-lampotila": {
                                "type": "number"
                            },
                            "tien-lampotila": {
                                "type": "number"
                            },
                            "keskituuli": {
                                "type": "integer"
                            },
                            "sateen-olomuoto": {
                                "type": "number"
                            },
                            "sadesumma": {
                                "type": "integer"
                            }
                        },
                        "required": ["havaintoaika", "aseman-tunniste", "aseman-tietojen-paivityshetki", "ilman-lampotila"]
                    }
                }
            }
        },
        "poikkeukselliset-saahavainnot": {
            "type": "array",
            "description": "Poikkeukselliset paikalliset keliolosuhteet (omat havainnot).",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "poikkeuksellinen-saahavainto": {
                        "type": "object",
                        "properties": {
                            "havaintoaika": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "paikka": {
                                "type": "string"
                            },
                            "kuvaus": {
                                "type": "string"
                            }
                        },
                        "required": ["havaintoaika", "paikka", "kuvaus"]
                    }
                }
            }
        },
        "kaluston-kaytto": {
            "type": "array",
            "minItems": 1,
            "description": "Resurssien käyttö mitatuilta ajankohdilta, yhdestä työkoneesta tulee yksi merkintä riippumatta töistä mitä suorittaa urakka-alueella. Lisäkaluston käyttö mitatuilta ajankohdilta, yhdestä työkoneesta tulee yksi merkintä riippumatta töistä mitä suorittaa urakka-alueella.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "kalusto": {
                        "type": "object",
                        "properties": {
                            "aloitus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "lopetus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "tyokoneiden-lkm": {
                                "type": "integer"
                            },
                            "lisakaluston-lkm": {
                                "type": "integer"
                            }
                        },
                        "required": ["aloitus", "lopetus", "tyokoneiden-lkm", "lisakaluston-lkm"]
                    }
                }
            }
        },
        "paivystajan-tiedot": {
            "type": "array",
            "minItems": 1,
            "description": "Päivystäjän/päivystäjien tiedot.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "paivystaja": {
                        "type": "object",
                        "properties": {
                            "aloitus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "lopetus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "nimi": {
                                "type": "string"
                            }
                        },
                        "required": ["aloitus", "nimi"]
                    }
                }
            }
        },
        "tyonjohtajan-tiedot": {
            "type": "array",
            "description": "Työnjohtajan/Työnjohtajien tiedot.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "tyonjohtaja": {
                        "type": "object",
                        "properties": {
                            "aloitus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "lopetus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "nimi": {
                                "type": "string"
                            }
                        },
                        "required": ["aloitus", "nimi"]
                    }
                }
            }
        },
        "tieston-toimenpiteet": {
            "type": "array",
            "minItems": 1,
            "description": "Yleiskuvaus tärkeimmistä tapahtumista: esim. ”pistehiekoituksia”. Näytetään tehdyt työnimikkeet ilman määriä mitattavilta ajankohdilta.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "tieston-toimenpide": {
                        "type": "object",
                        "properties": {
                            "aloitus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "lopetus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "tehtavat": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "tehtava": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": ["id"]
                                        }
                                    },
                                    "required": ["tehtava"]
                                }
                            }
                        },
                        "required": ["aloitus", "tehtavat"]
                    }
                }
            }
        },
        "tieston-muut-toimenpiteet": {
            "type": "array",
            "description": "Kirjataan tiestölle tehdyt muut toimenpiteet mitattavilta ajankohdilta",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "tieston-muu-toimenpide": {
                        "type": "object",
                        "properties": {
                            "aloitus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "lopetus": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "tehtavat": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "tehtava": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "kuvaus": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": ["kuvaus"]
                                        }
                                    },
                                    "required": ["tehtava"]
                                }
                            }
                        },
                        "required": ["aloitus", "tehtavat"]
                    }
                }
            }
        },
        "liikenteenohjaus-muutokset": {
            "type": "array",
            "description": "Tilapäiset liikenteenohjaus muutokset (nopeusrajoitus,painorajoitus, kiertotie jne.) Kirjataan päiväkirjaan (yksittäiset erikseen, talviajan nopeus rajoitukset massana, isommat liikenteen ohjaukset liikenteenohjaussuunnitelman mukaan)",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "liikenteenohjaus-muutos": {
                        "kuvaus": {
                            "type": "string"
                        }
                    }
                },
                "required": ["liikenteenohjaus-muutos"]
            }
        },
        "onnettomuudet": {
            "type": "array",
            "description": "Tietoon tulleet onnettomuudet, jotka todennäköisesti edellyttävät jälkikäteen tehtävän urakoitsijan selvityksen laatimista (olosuhteet ja toimenpiteet).",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "onnettomuus": {
                        "kuvaus": {
                            "type": "string"
                        }
                    }
                },
                "required": ["onnettomuus"]
            }
        },
        "viranomaisen-avustaminen": {
            "type": "array",
            "description": "Esim. siirtoajoneuvot, vahingonkorvaus. Tähän kommentoidaan onko katselmuksia pidetty.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "viranomaisen-avustus": {
                        "kuvaus": {
                            "type": "string"
                        },
                        "tunnit": {
                            "description": "Käytetty aika tunteina kahden desimaalin tarkkuudella",
                            "type": "number"
                        }
                    }
                },
                "required": ["viranomaisen-avustus"]
            }
        },
        "palautteet": {
            "type": "array",
            "description": "Asiakkaiden, median yhteydenotot ja palautteet, jotka koskevat tilaajaa (jatkotoimia aiheuttavat). Tässä ei kirjata kaikkia, vaan oleelliset palautteet.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "palaute": {
                        "type": "object",
                        "properties": {
                            "kuvaus": {
                                "type": "string"
                            }
                        },
                        "required": ["kuvaus"]
                    }
                }
            }
        },
        "muut-kirjaukset": {
            "type": "object",
            "description": "Vapaa kenttä muille tarpeellisille kirjauksille.",
            "properties": {
                "kuvaus": {
                    "type": "string"
                }
            },
            "required": ["kuvaus"]
        },
        "urakoitsijan-merkinnat": {
          "type": "object",
          "description": "Vapaa kenttä urakoitsijan merkinnöille.",
          "properties": {
              "kuvaus": {
                  "type": "string"
              }
          },
          "required": ["kuvaus"]
        },
        "tilaajan-yhteydenotot": {
            "type": "array",
            "description": "Tilaajan huomautukset työmaapäiväkirjaan.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "tilaajan-yhteydenotto": {
                        "kuvaus": {
                            "type": "string"
                        }
                    }
                },
                "required": ["tilaajan-yhteydenotto"]
            }
        }
    },
    "required": ["tunniste"]
}
