{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/yllapitokohde",
  "type": "object",
  "properties": {
    "tunniste": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
    },
    "sopimus": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
    },
    "kohdenumero": {
      "type": "string",
      "maxLength": 16
    },
    "nimi": {
      "type": "string",
      "maxLength": 128
    },
    "tunnus": {
      "type": "string",
      "maxLength": 1
    },
    "tyyppi": {
      "enum": [
        "paallyste",
        "sora",
        "kevytliikenne"
      ]
    },
    "tyotyyppi": {
      "enum": [
        "paikkaus",
        "paallystys"
      ]
    },
    "sijainti": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tiesijainti-myos-vanhat-kaistat.schema.json"
    },
    "yllapitoluokka": {
      "type": "integer"
    },
    "keskimaarainen-vuorokausiliikenne": {
      "type": "integer"
    },
    "nykyinen-paallyste": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/paallyste.schema.json"
    },
    "alikohteet": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "alikohde": {
            "type": "object",
            "additionalProperties": false,
            "$ref": "file:resources/api/schemas/entities/yllapitoalikohde.schema.json"
          }
        },
        "required": ["alikohde"]
      }
    },
    "aikataulu": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/aikataulu.schema.json"
    }
  },
  "required": ["tunniste", "tyotyyppi"]
}
