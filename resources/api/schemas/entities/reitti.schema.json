{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/reitti",
  "type": "array",
  "maxItems": 20000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reittipiste": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aika": {
            "type": "string",
            "format": "date-time"
          },
          "koordinaatit": {
            "type": "object",
            "additionalProperties": false,
            "$ref": "file:resources/api/schemas/entities/koordinaattisijainti.schema.json"
          },
          "tehtavat": {
            "type": "object",
            "additionalProperties": false,
            "$ref": "file:resources/api/schemas/entities/tehtavat.schema.json"
          },
          "materiaalit": {
            "type": "object",
            "additionalProperties": false,
            "$ref": "file:resources/api/schemas/entities/materiaalit.schema.json"
          },
          "havainnot": {
            "type": "object",
            "additionalProperties": false,
            "$ref": "file:resources/api/schemas/entities/havainnot.schema.json"
          },
          "mittaustulokset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mittaaja": {
                "type": "string"
              },
              "talvihoito": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "hoitoluokka": {
                    "type": "integer"
                  },
                  "lumisuus": {
                    "type": "number"
                  },
                  "tasaisuus": {
                    "type": "number"
                  },
                  "kitka": {
                    "type": "number"
                  },
                  "lampotila": {
                    "type": "number"
                  },
                  "laatuvirheet": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "liukkaus": {
                        "type": "boolean"
                      },
                      "lumisuus": {
                        "type": "boolean"
                      },
                      "tasaisuus": {
                        "type": "boolean"
                      }
                    },
                    "required": ["liukkaus", "lumisuus", "tasaisuus"]
                  }
                },
                "required": ["hoitoluokka", "lumisuus", "tasaisuus", "kitka", "lampotila", "laatuvirheet"]
              },
              "soratie": {
                "type": "object",
                "properties": {
                  "hoitoluokka": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                  },
                  "tasaisuus": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "kiinteys": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "polyavuus": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "sivukaltevuus": {
                    "type": "number"
                  }
                },
                "required": ["hoitoluokka", "tasaisuus", "kiinteys", "polyavuus", "sivukaltevuus"]
              }
            },
            "required": ["mittaaja", "talvihoito", "soratie"]
          }
        },
        "required": [
          "aika",
          "koordinaatit",
          "tehtavat",
          "materiaalit",
          "havainnot",
          "mittaustulokset"
        ]
      }
    },
    "required": ["reittipiste"]
  }
}
