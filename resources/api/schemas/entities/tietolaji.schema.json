{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tunniste": {
      "type": "string"
    },
    "ominaisuudet": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ominaisuus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kenttatunniste": {
                "type": "string"
              },
              "jarjestysnumero": {
                "type": "integer",
                "_comment": "FIXME: jarjestysnumero pakolliseksi. Sonjasta tähän tulee välillä nulleja."
              },
              "pituus": {
                "type": "integer"
              },
              "pakollinen": {
                "type": "boolean"
              },
              "selite": {
                "type": "string"
              },
              "tietotyyppi": {
                "enum": [
                  "merkkijono",
                  "j",
                  "koodisto",
                  "numeerinen",
                  "paivamaara"
                ],
                "_comment": "FIXME: tietotyyppi j tulee Sonjasta mutta vaikuttaa bugilta."
              },
              "desimaalit": {
                "type": ["integer", "null"]
              },
              "alaraja": {
                "type": ["integer","null"]
              },
              "ylaraja": {
                "type": ["integer", "null"]
              },
              "muutospvm": {
                "type": "string",
                "format": "date-time"
              },
              "voimassaolo": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "alkupvm": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "loppupvm": {
                    "type": ["string", "null"],
                    "format": "date-time"
                  }
                }
              },
              "koodisto": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "koodiryhma": {
                      "type": "string"
                    },
                    "koodi": {
                      "type": "integer"
                    },
                    "lyhenne": {
                      "type": "string"
                    },
                    "selite": {
                      "type": "string"
                    },
                    "muutospvm": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "voimassaolo": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "alkupvm": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "loppupvm": {
                          "type": ["string", "null"],
                          "format": "date-time"
                        }
                      }
                    }
                  },
                  "required": ["koodiryhma", "koodi", "lyhenne", "selite"]
                }
              }
            },
            "required": ["kenttatunniste", "selite", "tietotyyppi"]
          }
        }
      }
    }
  },
  "required": ["tunniste"]
}
