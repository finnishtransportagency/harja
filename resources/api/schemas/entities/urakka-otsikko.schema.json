{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/urakka-otsikko",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "nimi": {
      "type": "string"
    },
    "urakoitsija": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ytunnus": {
          "type": "string"
        },
        "nimi": {
          "type": "string"
        }
      },
      "required": ["nimi"]
    },
    "lyhyt-nimi": {
      "type": "string"
    },
    "vaylamuoto": {
      "type": "string"
    },
    "tyyppi": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/urakkatyyppi.schema.json"
    },
    "alkupvm": {
      "type": "string",
      "format": "date-time"
    },
    "loppupvm": {
      "type": "string",
      "format": "date-time"
    },
    "alueurakkanumero": {
      "type": "string"
    }
  },
  "required": ["id", "nimi", "urakoitsija", "vaylamuoto", "tyyppi", "alkupvm", "loppupvm"]
}
