{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/toteuma",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tunniste": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
    },
    "alueurakkanumero": {
      "type": ["string", "integer"]
    },
    "sopimusId": {
      "type": "integer"
    },
    "alkanut": {
      "type": "string",
      "format": "date-time"
    },
    "paattynyt": {
      "type": "string",
      "format": "date-time"
    },
    "suorittaja": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nimi": {
          "type": "string"
        },
        "ytunnus": {
          "type": "string"
        }
      }
    },
    "toteumatyyppi": {
      "enum": [
        "yksikkohintainen",
        "kokonaishintainen",
        "akillinen-hoitotyo",
        "lisatyo",
        "muutostyo",
        "vahinkojen-korjaukset"
      ]
    },
    "lisatieto": {
      "type": "string"
    },
    "tehtavat": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tehtavat.schema.json"
    },
    "materiaalit": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/materiaalit.schema.json"
    },
    "tiesijainti": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/tiesijainti.schema.json"
    },
    "muutostiedot": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/muutostiedot.schema.json"
    },
    "poistettu": {
      "type": "boolean"
    }
  },
  "required": [
    "tunniste",
    "alkanut",
    "paattynyt",
    "toteumatyyppi"
  ]
}
