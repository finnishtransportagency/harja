{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/soratietarkastuksen-kirjaus-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "tarkastukset": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tarkastus": {
            "type": "object",
            "additionalProperties": false,
            "$ref": "file:resources/api/schemas/entities/tarkastus.schema.json"
          },
          "mittaus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hoitoluokka": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "tasaisuus": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "kiinteys": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "polyavyys": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "sivukaltevuus": {
                "type": "number"
              }
            }
          }
        },
        "required": ["tarkastus", "mittaus"]
      }
    }
  },
  "required": ["otsikko"]
}
