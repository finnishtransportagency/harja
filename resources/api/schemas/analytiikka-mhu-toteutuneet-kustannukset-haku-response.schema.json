{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "toteutuneet-kustannukset": {
      "type": "object",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "urakka": {
            "type": "integer",
            "description": "Harjan urakka-id."
          },
          "urakkatunnus": {
            "type": "string",
            "description": "Urakasta eri järjestelmissä ja geometria-aineistoissa käytetty tunniste. Uudemmissa urakoissa sama kuin urakan Sampo-id, vanhemmissa urakoissa tunnisteena käytetään alueurakkanumeroa."
          }
        },
        "kulut": {
          "type": "array",
          "properties": {
            "kulu": {
              "type": "object",
              "properties": {
                "kulu-id": {
                  "type": "integer",
                  "description": "Kustannusrivin id Harjassa."
                },
                "laskun-tunniste": {
                  "type": "string",
                  "description": "Laskun tunniste urakoitsijan kirjanpidossa."
                },
                "kulun-kuvaus": {
                  "type": "string",
                  "description": "Kuluun kirjattu lisätieto."
                },
                "poistettu": {
                  "type": "boolean",
                  "description": "True kun koko kulu kaikkine kohdistuksineen on merkitty Harjassa poistetuksi. Oletus: false."
                },
                "kulun-ajankohta": {
                  "type": "object",
                  "properties": {
                    "koontilaskun-vuosi": {
                      "type": "integer",
                      "description": "Koontilaskun vuosi. Kalenterivuosi jota toteutunut kustannus koskee."
                    },
                    "koontilaskun-kuukausi": {
                      "type": "integer",
                      "description": "Koontilaskun vuosi. Kalenterikuukausi jota toteutunut kustannus koskee."
                    },
                    "laskun-paivamaara": {
                      "type": "string",
                      "format": "date",
                      "description": "Laskun päivämäärä."
                    },
                    "required": [
                      "koontilaskun-vuosi",
                      "koontilaskun-kuukausi",
                      "laskun-paivamaara"
                    ]
                  }
                },
                "kulun-kokonaissumma": {
                  "type": "number",
                  "description": "Koontilaskun kustannusten kokonaismäärä. Yksikkö: euro."
                },
                "kulukohdistukset": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kulukohdistus": {
                        "type": "object",
                        "properties": {
                          "kulukohdistus-id": {
                            "type": "integer",
                            "description": "Yksittäisen kulurivin (kulukohdistuksen) id Harjassa."
                          },
                          "rivinumero": {
                            "type": "integer",
                            "description": "Yksittäisen kulurivin (kulukohdistuksen) järjestys kulukokonaisuudessa."
                          },
                          "tyyppi": {
                            "type": "string",
                            "description": "Kulukohdstukseen tyyppi. Tyypitys on uudistuksen kohteena 2024, sen takia string, ei enumia."
                          },
                          "lisatieto": {
                            "type": "string",
                            "description": "Kulukohdstukseen kirjattu lisätieto."
                          },
                          "poistettu": {
                            "type": "boolean",
                            "default": false,
                            "description": "True kun koko kulu kaikkine kohdistuksineen on merkitty Harjassa poistetuksi. Oletus: false."
                          },
                          "summa": {
                            "type": "number",
                            "description": "Yksittäisen kulurivin (kulukohdistuksen) summa. Yksikkö: euro."
                          },
                          "kohdistus": {
                            "type": "object",
                            "properties": {
                              "toimenpide": {
                                "type": "integer",
                                "description": "Harjan toimenpide-id."
                              },
                              "tehtavaryhma": {
                                "type": "integer",
                                "description": "Harjan tehtavaryhma-id."
                              },
                              "rahavaraus": {
                                "type": "integer",
                                "description": "Harjan rahavaraus-id."
                              },
                              "tehtava": {
                                "type": "integer",
                                "description": "Harjan tehtava-id."
                              }
                            },
                            "required": [
                              "toimenpide"
                            ]
                          }
                        },
                        "required": [
                          "kulukohdistus-id",
                          "rivinumero",
                          "tyyppi",
                          "summa",
                          "kohdistus"
                        ]
                      }
                    }
                  }
                }
              },
              "required": [
                "kulu-id",
                "kulun-ajankohta",
                "kulun-kokonaissumma",
                "kulukohdistukset"
              ]
            }
          }
        },
        "sanktiot": {
          "type": "array",
          "properties": {
            "sanktio": {
              "type": "object",
              "properties": {
                "sanktio-id": {
                  "type": "integer",
                  "description": "Sanktiorivin id Harjassa."
                },
                "sanktion-ajankohta": {
                  "type": "string",
                  "format": "date",
                  "description": "Ajankohta jolloin sanktioon liittyvä maksu kirjanpidon kannalta toteutuu."
                },
                "sanktion-maara": {
                  "type": "number",
                  "description": "Sanktion määrä euroissa."
                },
                "indeksi": {
                  "type": "string",
                  "description": "Sanktion määrän laskennassa käytetty indeksi, jos määrässä on indeksikorjaus mukana. Esim. MAKU 2015."
                },
                "bonustyyppi": {
                  "type": "enum",
                  "description": ""
                },
                "bonuksen-kasittelytapa": {
                  "type": "enum",
                  "description": ""
                },
                "poistettu": {
                  "type": "boolean",
                  "description": "True kun sanktio on merkitty poistetuksi Harjassa. Oletus: false."
                }
              },
              "required": [
                "sanktio-id",
                "sanktion-ajankohta"
              ]
            }
          }
        },
        "bonukset": {
          "type": "array",
          "properties": {
            "bonus": {
              "type": "object",
              "properties": {
                "bonus-id": {
                  "type": "integer",
                  "description": "Bonusrivin id Harjassa."
                },
                "bonuksen-ajankohta": {
                  "type": "string",
                  "format": "date",
                  "description": "Bonuksen päiväys (laskut."
                },
                "bonuksen-maara": {
                  "type": "number",
                  "description": "Bonuksen määrä euroissa."
                },
                "indeksi": {
                  "type": "string",
                  "description": "Sanktion määrän laskennassa käytetty indeksi, jos määrässä on indeksikorjaus mukana. Esim. MAKU 2015."
                },
                "suorasanktio": {
                  "type": "boolean",
                  "description": "True kun sanktio on suorasanktio. Oletus: false."
                },
                "sanktiolaji": {
                  "type": "object",
                  "properties": {
                    "koodi": {
                      "type": "integer",
                      "description": "Sanktiolajin koodi Harjassa."
                    },
                    "nimi": {
                      "type": "string",
                      "description": "Sanktiolajin nimi Harjassa."
                    }
                  }
                },
                "sanktio-liittyy-laatupoikkeamaan": {
                  "type": "boolean",
                  "description": "True kun sanktio on linkitetty raportoituun laatupoikkeamaan. Oletus: false."
                },
                "poistettu": {
                  "type": "boolean",
                  "description": "True kun bonus on merkitty poistetuksi Harjassa. Oletus: false."
                }
              },
              "required": [
                "bonus-id",
                "bonuksen-ajankohta"
              ]
            }
          }
        },
        "tavoitehinnan_oikaisut": {
          "type": "array",
          "properties": {
            "tavoitehinnan-oikaisu": {
              "type": "object",
              "properties": {
                "oikaisu-id": {
                  "type": "integer",
                  "description": "Tavoitehinnan oikaisurivin id Harjassa. Huom. Älä laske tavoitehinnan oikaisuja mukaan, kun lasket yhteen toteutuneita kustannuksia. Oikaisumääriä voi pitää jonkinlaisena erittelynä välikatselmuksessa mahdollisesti syntyville kulukirjauksille. Nämä kirjaukset kohdistuvat kolmeen tehtäväryhmään: Hoitovuoden päättäminen / Tavoitepalkkio, Hoitovuoden päättäminen / Urakoitsija maksaa kattohinnan ylityksestä, Hoitovuoden päättäminen / Urakoitsija maksaa tavoitehinnan ylityksestä."
                },
                "oikaisun-hoitokausi": {
                  "type": "integer",
                  "description": "Sen hoitokauden alkuvuosi, jota tavoitehinnan oikaisu koskee. Jos hoitokausi on 2023-24, tässä palautuu 2023."
                },
                "oikaisukategoria": {
                  "type": "string",
                  "description": "Tavoitehinnan oikaisun luokittelu. Arvot 28.1.2024 (muutoksiin on syytä varautua): Alleviivatun fontin vaikutus tavoitehintaan, Bonukset ja sanktiot, Hoitoluokkamuutokset, Liikennejärjestelyt, Materiaalit, Muut, Tehtävämuutokset, Tiestömuutokset, Tiestömuutos, Työmäärämuutokset, Yleiset Liikennejärjestelyt."
                },
                "oikaisun-selite": {
                  "type": "string",
                  "description": "Vapaamuotoinen selite tavoitehinnan oikaisulle."
                },
                "oikaisun-summa": {
                  "type": "number",
                  "description": "Tavoitehinnan oikaisun määrä. Älä laske oikaisuna palautuneita määriä toteutuneiden kustannusten yhteissummaan. Tavoitehinnan oikaisujen ja välikatselmuksessa tehtyjen päätösten pohjalta lasketaan mahdollinen hoitokauden päättämiseen liittyvä kulu. Kulu kirjataan kulukohdistuksena jollekin näistä kolmesta tehtäväryhmästä: Hoitovuoden päättäminen / Tavoitepalkkio, Hoitovuoden päättäminen / Urakoitsija maksaa kattohinnan ylityksestä, Hoitovuoden päättäminen / Urakoitsija maksaa tavoitehinnan ylityksestä. Tavoitehinnan oikaisun määrä voi olla negatiivinen (tavoitehinnasta vähennetän) tai positiivinen (tavoitehintaan lisätään). Yksikkö: euro. "
                },
                "poistettu": {
                  "type": "boolean",
                  "default": false,
                  "description": "True kun oikaisu on merkitty Harjassa poistetuksi. Oletus: false."
                }
              },
              "required": [
                "oikaisu-id",
                "oikaisun-hoitokausi",
                "oikaisukategoria",
                "oikaisun-selite",
                "oikaisun-summa"
              ]
            }
          }
        }
      }
    }
  }
}
