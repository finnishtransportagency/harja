{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/urakan-yllapitokohteen-paivitys-request",
  "type": "object",
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "yllapitokohde": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sijainti": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/tieosoitevali.schema.json"
        },
        "alikohteet": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "alikohde": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tunniste": {
                    "type": "object",
                    "additionalProperties": false,
                    "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
                  },
                  "nimi": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "sijainti": {
                    "type": "object",
                    "additionalProperties": false,
                    "$ref": "file:resources/api/schemas/entities/tieosoitevali-kaistalla-ja-ajoradalla.schema.json"
                  },
                  "toimenpide": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "paallystetyyppi": {
                    "type": "object",
                    "additionalProperties": false,
                    "$ref": "file:resources/api/schemas/entities/paallyste.schema.json"
                  },
                  "raekoko": {
                    "$ref": "file:resources/api/schemas/entities/paallystys_raekoko.schema.json"
                  },
                  "tyomenetelma": {
                    "type": "object",
                    "additionalProperties": false,
                    "$ref": "file:resources/api/schemas/entities/paallystys_tyomenetelma.schema.json"
                  },
                  "massamaara": {
                    "type": "number"
                  }
                },
                "required": ["tunniste"]
              }
            },
            "required": ["alikohde"]
          }
        }
      }
    }
  },
  "required": ["otsikko", "yllapitokohde"]
}
