{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/talvihoitotarkastuksen-kirjaus-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "tarkastukset": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tarkastus": {
            "type": "object",
            "additionalProperties": false,
            "$ref": "file:resources/api/schemas/entities/tarkastus.schema.json"
          },
          "mittaus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hoitoluokka": {
                "type": "integer"
              },
              "lumimaara": {
                "type": "number"
              },
              "tasaisuus": {
                "type": "number"
              },
              "kitka": {
                "type": "number"
              },
              "lampotilaIlma": {
                "type": "number"
              },
              "lampotilaTie": {
                "type": "number"
              }
            }
          }
        },
        "required": ["tarkastus"]
      }
    }
  },
  "required": ["otsikko"]
}

