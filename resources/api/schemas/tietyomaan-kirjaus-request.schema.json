{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/tietyomaan-kirjaus-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "tietyomaa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "alkuaidan-sijainti": {
          "$ref": "file:resources/api/schemas/entities/sijainti.schema.json"
        },
        "loppuaidan-sijainti": {
          "$ref": "file:resources/api/schemas/entities/sijainti.schema.json"
        },
        "aika": {
          "type": "string",
          "format": "date-time"
        },
        "ajoradat": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "kaistat": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "enum": [
              11,
              12,
              13,
              14,
              15,
              16,
              17,
              18,
              19,
              21,
              22,
              23,
              24,
              25,
              26,
              27,
              28,
              29,
              31
            ]
          }
        },
        "nopeusrajoitus": {
          "type": "integer"
        }
      },
      "required": ["id", "alkuaidan-sijainti", "loppuaidan-sijainti", "aika"]
    }
  },
  "required": ["otsikko"]
}
