{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/urakan-yllapitokohteen-maaramuutosten-kirjaus-request",
  "type": "object",
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "maaramuutokset": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maaramuutos": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tunniste": {
                "type": "object",
                "additionalProperties": false,
                "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
              },
              "tyyppi": {
                "enum": [
                  "ajoradan_paallyste",
                  "pienaluetyot",
                  "tasaukset",
                  "jyrsinnat",
                  "muut"
                ]
              },
              "tyo": {
                "type": "string",
                "maxLength": 256
              },
              "yksikko": {
                "type": "string",
                "maxLength": 32
              },
              "tilattu-maara": {
                "type": "number"
              },
              "ennustettu-maara": {
                "type": "number"
              },
              "toteutunut-maara": {
                "type": "number"
              },
              "yksikkohinta": {
                "type": "number"
              }
            },
            "required": [
              "tunniste",
              "tyyppi",
              "tyo",
              "yksikko",
              "tilattu-maara",
              "ennustettu-maara",
              "toteutunut-maara",
              "yksikkohinta"
            ]
          }
        },
        "required": ["maaramuutos"]
      }
    }
  },
  "required": ["otsikko"]
}
