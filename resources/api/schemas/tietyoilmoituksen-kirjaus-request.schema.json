{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/tietyoilmoituksen-kirjaus-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "tietyoilmoitus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tunniste": {
          "type": "object",
          "additionalProperties": false,
          "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
        },
        "tyyppi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ensimmainenIlmoitus": {
              "type": "boolean"
            },
            "tyovaiheIlmoitus": {
              "type": "boolean"
            },
            "korjausTaiMuutosIlmoitus": {
              "type": "boolean"
            },
            "paattymisIlmoitus": {
              "type": "boolean"
            }
          }
        },
        "lupanumero": {
          "type": "string"
        },
        "tieliikenneKeskus": {
          "enum": [
            "helsinki",
            "tampere",
            "turku",
            "oulu"
          ]
        },
        "urakoitsija": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nimi": {
              "type": "string"
            },
            "yhteyshenkilo": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "nimi": {
                  "type": "string"
                },
                "puhelinnumero": {
                  "type": "string"
                },
                "sahkoposti": {
                  "type": "string"
                }
              },
              "required": ["nimi", "puhelinnumero", "sahkoposti"]
            }
          },
          "required": ["yhteyshenkilo"]
        },
        "tilaaja": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nimi": {
              "type": "string"
            },
            "yhteyshenkilo": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "nimi": {
                  "type": "string"
                },
                "puhelinnumero": {
                  "type": "string"
                },
                "sahkoposti": {
                  "type": "string"
                }
              },
              "required": ["nimi", "puhelinnumero", "sahkoposti"]
            }
          },
          "required": ["nimi", "yhteyshenkilo"]
        },
        "tyo": {
          "id": "urn:harja/tietyoilmoitus/tyo",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sijainti": {
              "$ref": "file:resources/api/schemas/entities/sijainti.schema.json"
            },
            "alkaa": {
              "type": "string",
              "format": "date-time"
            },
            "paattyy": {
              "type": "string",
              "format": "date-time"
            },
            "tehtavatTyot": {
              "type": "array",
              "maxItems": 10,
              "items": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ]
            },
            "selite": {
              "type": "string"
            },
            "lisatietoja": {
              "type": "string"
            },
            "paivittainenTyoaika": {
              "type": "string"
            },
            "vaikutuksetLiikenteelle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "yksiAjokaistaSuljettu": {
                  "type": "boolean"
                },
                "yksiAjorataSuljettu": {
                  "type": "boolean"
                },
                "tieSuljettuLiikenteelta": {
                  "type": "boolean"
                },
                "nopeusrajoitus": {
                  "enum": [
                    "30",
                    "40",
                    "50",
                    "60",
                    "70",
                    "80",
                    "100"
                  ]
                },
                "liikennevalot": {
                  "type": "boolean"
                },
                "liikenteenOhjaaja": {
                  "enum": [
                    "liikenne-ohjataan-vuorotellen-tapahtumapaikan-ohi",
                    "liikenne-ohjataan-kaksisuuntaisena-toiselle-ajoradalle"
                  ]
                },
                "tyokoneitaLiikenteenSeassa": {
                  "type": "boolean"
                },
                "satunnaisia": {
                  "enum": [
                    "liikenne-pysaytetaan-ajoittain",
                    "tie-on-ajoittain-suljettu-liikenteelta"
                  ]
                },
                "arvioituViivastys": {
                  "type": "integer"
                },
                "ajoneuvonMaxKorkeus": {
                  "type": "number"
                },
                "ajoneuvonMaxLeveys": {
                  "type": "number"
                },
                "ajoneuvonMaxPituus": {
                  "type": "number"
                },
                "painorajoitus": {
                  "type": "integer"
                },
                "suunta": {
                  "enum": [
                    "haittaa-molemmissa-ajosuunnissa",
                    "tienumeron-kasvusuuntaan",
                    "vasten-tienumeron-kasvusuuntaa"
                  ]
                }
              }
            },
            "ilmoittaja": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "urakoitsija": {
                  "type": "string"
                },
                "yhteyshenkilo": {
                  "type": "object",
                  "properties": {
                    "nimi": {
                      "type": "string"
                    },
                    "puhelinnumero": {
                      "type": "string"
                    },
                    "sahkoposti": {
                      "type": "string"
                    }
                  },
                  "required": ["nimi", "puhelinnumero", "sahkoposti"]
                }
              },
              "required": ["urakoitsija", "yhteyshenkilo"]
            }
          },
          "required": ["sijainti", "alkaa", "paattyy", "ilmoittaja"]
        }
      },
      "required": ["tunniste", "tyyppi", "lupanumero", "tieliikenneKeskus", "urakoitsija", "tilaaja", "tyo"]
    }
  },
  "required": ["otsikko"]
}
