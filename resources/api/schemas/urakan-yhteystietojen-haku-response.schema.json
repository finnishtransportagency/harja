{  
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "urn:harja/urakan-yhteystietojen-haku-response",
  "type": "object",
  "properties": {
    "urakka": {
      "type": "object",
      "properties": {
        "alkupvm": {
          "type": "string"
        },
        "alueurakkanro": {
          "type": "string"
        },
        "elynro": {
          "type": "number"
        },
        "elynimi": {
          "type": "string"
        },
        "loppupvm": {
          "type": "string"
        },
        "nimi": {
          "type": "string"
        },
        "sampoid": {
          "type": "string"
        },
        "urakoitsija": {
          "type": "object",
          "properties": {
            "katuosoite": {
              "type": "string"
            },
            "nimi": {
              "type": "string"
            },
            "postinumero": {
              "type": "string"
            },
            "ytunnus": {
              "type": "string"
            }
          }
        },
        "yhteyshenkilot": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "yhteyshenkilo": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "nimi": {
                    "type": "string"
                  },
                  "puhelinnumero": {
                    "type": "string"
                  },
                  "rooli": {
                    "type": "string",
                    "enum": [
                      "Urakan vastuuhenkilö",
                      "ELY urakanvalvoja",
                      "ELY laadunvalvoja",
                      "ELY turvallisuusvastaava",
                      "Tilaajan asiantuntija",
                      "Tilaajan urakanvalvoja",
                      "Tilaajan laadunvalvoja",
                      "Tilaajan turvallisuusvastaava",
                      "Paivystaja",
                      "Laatupaallikko",
                      "Kelikeskus",
                      "Laadunvalvoja",
                      "Sampo yhteyshenkilö",
                      "Kunnossapitopäällikkö",
                      "Sillanvalvoja",
                      "Tieliikennekeskus",
                      "Viranomais- ja vahingonkorvausasiat",
                      "Työmaavalvoja",
                      "Työmaavalvojan sijainen",
                      "Vastuunalainen työnjohtaja",
                      "Päätoiminen apulainen",
                      "Apulainen/Työnjohtaja/Vipa-tehtävät",
                      "Viherhoidosta vastaava henkilö"
                    ]
                  },
                  "vastuuhenkilo": {
                    "type": "boolean"
                  },
                  "varahenkilo": {
                    "type": "boolean"
                  },
                  "organisaatio": {
                    "type": "string"
                  }
                },
                "required": ["rooli"]
              }
            }
          }
        }
      }
    }
  }
}
