{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/paivystajatietojen-haku-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "paivystajatiedot": {
      "type": "array",
      "maxItems" : 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "urakka": {
            "type": "object",
            "properties": {
              "tiedot": {
                "type": "object",
                "additionalProperties": false,
                "$ref": "file:resources/api/schemas/entities/urakka-otsikko.schema.json"
              },
              "paivystykset": {
                "type": "array",
                "maxItems" : 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "paivystys": {
                      "$ref": "file:resources/api/schemas/entities/paivystys.schema.json"
                    }
                  },
                  "required": ["paivystys"]
                }
              }
            },
            "required": ["tiedot"]
          }
        },
        "required": ["urakka"]
      }
    }
  }
}
