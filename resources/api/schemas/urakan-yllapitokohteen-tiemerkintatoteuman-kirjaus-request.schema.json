{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/urakan-yllapitokohteen-tiemerkintatoteuman-kirjaus-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "tiemerkintatoteumat": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tiemerkintatoteuma": {
            "type": "object",
            "properties": {
              "tunniste": {
                "type": "object",
                "additionalProperties": false,
                "$ref": "file:resources/api/schemas/entities/tunniste.schema.json"
              },
              "hinta": {
                "type": "number",
                "minimum": 0
              },
              "paivamaara": {
                "type": "string",
                "format": "date-time"
              },
              "selite": {
                "type": "string"
              },
              "hintatyyppi": {
                "type": "string",
                "enum": [
                  "toteuma",
                  "suunnitelma"
                ]
              }
            },
            "required": [
              "tunniste",
              "hinta",
              "paivamaara",
              "selite",
              "hintatyyppi"
            ]
          }
        },
        "required": ["tiemerkintatoteuma"]
      }
    }
  },
  "required": [
    "otsikko",
    "tiemerkintatoteumat"
  ]
}
