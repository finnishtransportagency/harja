{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tiemerkinnan-kustannukset": {
      "type": "array",
      "description": "Lista urakoiden tiemerkinnan kustannuksista",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "urakkaid": {
            "type": "integer",
            "description": "Urakan tunniste"
          },
          "urakkanro": {
            "type": "string",
            "description": "Urakasta eri järjestelmissä ja geometria-aineistoissa käytetty tunniste. Uudemmissa urakoissa sama kuin urakan Sampo-id, vanhemmissa urakoissa tunnisteena käytetään alueurakkanumeroa."
          },
          "korjauskustannukset": {
            "type": "array",
            "description": "Lista korjauskustannuksista sopimusvuosittain",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sopimusvuosi": {
                  "type": "integer",
                  "description": "Kustannusvuosi"
                },
                "kustannus": {
                  "type": "number",
                  "description": "Korjauskustannusten kokonaissumma euroina"
                },
                "pk1%": {
                  "type": ["number", "null"],
                  "description": "PK1-luokan prosenttiosuus kokonaiskustannuksista"
                },
                "pk2%": {
                  "type": ["number", "null"],
                  "description": "PK2-luokan prosenttiosuus kokonaiskustannuksista"
                },
                "pk3%": {
                  "type": ["number", "null"],
                  "description": "PK3-luokan prosenttiosuus kokonaiskustannuksista"
                },
                "korjauskustannus-luotu": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Korjauskustannuksen luontiaika"
                },
                "korjauskustannus-muokattu": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Korjauskustannuksen muokkausaika"
                }
              },
              "required": [
                "sopimusvuosi",
                "kustannus",
                "pk1%",
                "pk2%",
                "pk3%",
                "korjauskustannus-luotu",
                "korjauskustannus-muokattu"
              ]
            }
          },
          "yllapitokohdekustannukset": {
            "type": "array",
            "description": "Lista ylläpitokohteen kustannuksista sopimusvuosittain",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sopimusvuosi": {
                  "type": "integer",
                  "description": "Kustannusvuosi"
                },
                "nimi": {
                  "type": "string",
                  "description": "Ylläpitokohteen nimi"
                },
                "kohdenumero": {
                  "type": ["string", "integer"],
                  "description": "Ylläpitokohteen numero"
                },
                "sijainti": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "tie": {
                      "type": "integer",
                      "description": "Tien numero"
                    },
                    "alkuosa": {
                      "type": "integer",
                      "description": "Alkuosa"
                    },
                    "alkuetaisyys": {
                      "type": "integer",
                      "description": "Alkuetäisyys"
                    },
                    "loppuosa": {
                      "type": "integer",
                      "description": "Loppuosa"
                    },
                    "loppuetaisyys": {
                      "type": "integer",
                      "description": "Loppuetäisyys"
                    }
                  },
                  "required": [
                    "tie",
                    "alkuosa",
                    "alkuetaisyys",
                    "loppuosa",
                    "loppuetaisyys"
                  ]
                },
                "linjamerkinnat": {
                  "type": "number",
                  "description": "Linjamerkintöjen kustannukset euroina"
                },
                "pienmerkinnat": {
                  "type": "number",
                  "description": "Pienmerkintöjen kustannukset euroina"
                },
                "jyrsinnat": {
                  "type": "number",
                  "description": "Jyrsintöjen kustannukset euroina"
                },
                "muut-kustannukset": {
                  "type": "number",
                  "description": "Muut kustannukset euroina"
                },
