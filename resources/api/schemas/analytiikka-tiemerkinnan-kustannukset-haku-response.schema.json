                  "type": "boolean",
                  "description": "Onko ylläpitokohde poistettu"
                },
                "yllapitokohde-kustannus-luotu": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Ylläpitokohteen kustannuksen luontiaika"
                },
                "yllapitokohde-kustannus-muokattu": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Ylläpitokohteen kustannuksen muokkausaika"
                }
              },
              "required": [
                "sopimusvuosi",
                "nimi",
                "kohdenumero",
                "sijainti",
                "linjamerkinnat",
                "pienmerkinnat",
                "jyrsinnat",
                "muut-kustannukset",
                "yllapitokohde-poistettu",
                "yllapitokohde-kustannus-luotu",
                "yllapitokohde-kustannus-muokattu"
              ]
            }
          },
