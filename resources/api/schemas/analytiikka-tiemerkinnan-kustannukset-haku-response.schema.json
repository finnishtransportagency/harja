                    "tie": {
                      "type": "integer",
                      "description": "Tien numero"
                    },
                    "alkuosa": {
                      "type": "integer",
                      "description": "Alkuosa"
                    },
                    "alkuetaisyys": {
                      "type": "integer",
                      "description": "Alkuetäisyys"
                    },
                    "loppuosa": {
                      "type": "integer",
                      "description": "Loppuosa"
                    },
                    "loppuetaisyys": {
                      "type": "integer",
                      "description": "Loppuetäisyys"
                    }
                  },
                  "required": [
                    "tie",
                    "alkuosa",
                    "alkuetaisyys",
                    "loppuosa",
                    "loppuetaisyys"
                  ]
                },
                "linjamerkinnat": {
                  "type": "number",
                  "description": "Linjamerkintöjen kustannukset euroina"
                },
                "pienmerkinnat": {
                  "type": "number",
                  "description": "Pienmerkintöjen kustannukset euroina"
                },
                "jyrsinnat": {
                  "type": "number",
                  "description": "Jyrsintöjen kustannukset euroina"
                },
                "muut-kustannukset": {
                  "type": "number",
                  "description": "Muut kustannukset euroina"
                },
                "paikkauskohde-poistettu": {
                  "type": "boolean",
                  "description": "Onko paikkauskohde poistettu"
                },
                "paikkauskohde-kustannus-luotu": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Paikkauskohteen kustannuksen luontiaika"
                },
                "paikkauskohde-kustannus-muokattu": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Paikkauskohteen kustannuksen muokkausaika"
                }
              },
              "required": [
                "sopimusvuosi",
                "nimi",
                "kohdenumero",
                "sijainti",
                "linjamerkinnat",
                "pienmerkinnat",
                "jyrsinnat",
                "muut-kustannukset",
                "paikkauskohde-poistettu",
                "paikkauskohde-kustannus-luotu",
                "paikkauskohde-kustannus-muokattu"
              ]
            }
          }
