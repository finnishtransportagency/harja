              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sopimusvuosi": {
                  "type": "integer",
                  "description": "Kustannusvuosi"
                },
                "nimi": {
                  "type": "string",
                  "description": "Paikkauskohteen nimi"
                },
                "kohdenumero": {
                  "type": ["string", "integer"],
                  "description": "Paikkauskohteen numero"
                },
                "sijainti": {
                  "type": "object",
