{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/tietyomaan-poisto-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "tietyomaa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "aika": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "aika"]
    }
  },
  "required": ["otsikko"]
}
