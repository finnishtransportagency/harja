{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/tyokoneenseurannan-kirjaus-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "havainnot": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "havainto": {
            "type": "object",
            "properties": {
              "tyokone": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "tunnus": {
                    "type": "string"
                  },
                  "tyokonetyyppi": {
                    "type": "string"
                  }
                },
                "required": ["id", "tyokonetyyppi"]
              },
              "sijainti": {
                "$ref": "file:resources/api/schemas/entities/geometria-sijainti.schema.json"
              },
              "suunta": {
                "anyOf": [
                  {"type": "number"},
                  {"type": "null"}
                ]
              },
              "urakkaid": {
                "type": "integer"
              },
              "havaintoaika": {
                "type": "string",
                "format": "date-time"
              },
              "suoritettavatTehtavat": {
                "type": "object",
                "additionalProperties": false,
                "$ref": "file:resources/api/schemas/entities/suoritettavat-tehtavat.schema.json"
              }
            },
            "required": ["tyokone", "sijainti", "havaintoaika"]
          }
        },
        "required": ["havainto"]
      }
    }
  },
  "required": ["otsikko", "havainnot"]
}
