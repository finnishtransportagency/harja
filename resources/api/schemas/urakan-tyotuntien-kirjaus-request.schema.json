{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/urakan-tyotuntien-kirjaus-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "tyotunnit": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vuosikolmannes": {
            "type": "object",
            "properties": {
              "vuosi": {
                "type": "number"
              },
              "kolmannes": {
                "type": "number",
                "minimum": 1,
                "maximum": 3
              },
              "tunnit": {
                "type": "number"
              }
            },
            "required": ["vuosi", "kolmannes", "tunnit"]
          }
        },
        "required": ["vuosikolmannes"]
      }
    }
  },
  "required": ["otsikko", "tyotunnit"]
}
