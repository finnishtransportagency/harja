{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/ilmoitustoimenpiteen-kirjaaminen-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "ilmoitustoimenpide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aika": {
          "type": "string",
          "format": "date-time"
        },
        "tyyppi": {
          "enum": [
            "vastaanotto",
            "aloitus",
            "muutos",
            "lopetus",
            "vastaus"
          ]
        },
        "aiheutti-toimenpiteita": {
          "type": "boolean"
        },
        "ilmoittaja": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "henkilo": {
              "type": "object",
              "additionalProperties": false,
              "$ref": "file:resources/api/schemas/entities/henkilo.schema.json"
            },
            "organisaatio": {
              "type": "object",
              "additionalProperties": false,
              "$ref": "file:resources/api/schemas/entities/organisaatio.schema.json"
            }
          },
          "required": ["henkilo", "organisaatio"]
        },
        "kasittelija": {
          "id": "urn:harja/ilmoitustoimenpide/kasittelija",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "henkilo": {
              "type": "object",
              "additionalProperties": false,
              "$ref": "file:resources/api/schemas/entities/henkilo.schema.json"
            },
            "organisaatio": {
              "type": "object",
              "additionalProperties": false,
              "$ref": "file:resources/api/schemas/entities/organisaatio.schema.json"
            }
          },
          "required": ["henkilo", "organisaatio"]
        },
        "vapaateksti": {
          "type": "string"
        }
      },
      "required": ["aika", "tyyppi", "ilmoittaja", "kasittelija"]
    }
  },
  "required": ["otsikko", "ilmoitustoimenpide"]
}
