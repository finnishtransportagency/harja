{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "tehtavat": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "nimi": {
            "type": "string"
          },
          "tehtavaryhma": {
            "type": ["integer", "null"]
          },
          "emo": {
            "type": ["integer", "null"]
          },
          "toimenpidekoodi": {
            "type": ["string", "null"]
          },
          "hinnoittelu": {
            "type": "array",
            "items": {
              "type": ["string", "null"]
            }
          },
          "suunnitteluyksikko": {
            "type": ["string", "null"]
          },
          "jarjestys": {
            "type": ["integer", "null"]
          },
          "materiaaliluokka_id": {
            "type": ["integer", "null"]
          },
          "yksikko": {
            "type": ["string", "null"]
          },
          "materiaalikoodi_id": {
            "type": ["integer", "null"]
          },
          "yksiloiva_tunniste": {
            "type": ["string", "null"]
          },
          "voimassaolo_alkuvuosi": {
            "type": ["integer", "null"]
          },
          "voimassaolo_loppuvuosi": {
            "type": ["integer", "null"]
          },
          "piilota": {
            "type": ["boolean", "null"]
          },
          "suoritettavatehtava": {
            "type": ["string", "null"]
          },
          "kasin_lisattava_maara": {
            "type": "boolean"
          },
          "aluetieto": {
            "type": "boolean",
            "$comment": "Jos true, tehtävän suunniteltu määrä on luonteeltaan urakka-aluetta kuvaileva (esim. hoitoluokkatehtävät)."
          },
          "raportoi-tehtava?": {
            "type": "boolean"
          },
          "ensisijainen": {
            "type": "boolean",
            "$comment": "Tämä tieto löytyy Harjassa sarakkeesta TEHTAVA.mhu-tehtava?"
          },
          "maaramitattava": {
            "type": "boolean",
            "$comment": "Jos true, tehtävän suunniteltuja ja toteutuneita määriä seurataan tehtävän yksikön mukaan."
          },
          "muokattu": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "luotu": {
            "type": "string",
            "format": "date-time"
          },
          "poistettu": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "nimi",
          "kasin_lisattava_maara",
          "aluetieto",
          "poistettu"
        ]
      }
    },
    "tehtavaryhmat": {
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nimi": {
            "type": "string"
          },
          "otsikko": {
            "type": "string"
          },
          "jarjestys": {
            "type": "integer"
          },
          "yksiloiva_tunniste": {
            "type": ["string", "null"]
          },
          "voimassaolo_loppuvuosi": {
            "type": ["integer", "null"]
          },
          "toimenpidekoodi": {
            "type": "string"
          },
          "voimassaolo_alkuvuosi": {
            "type": ["integer", "null"]
          },
          "luotu": {
            "type": "string",
            "format": "date-time"
          },
          "muokattu": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "poistettu": {
            "type": "boolean"
          },
          "versio": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "luotu",
          "nimi",
          "otsikko",
          "id",
          "poistettu"
        ]
      }
    }
  },
  "required": ["tehtavat", "tehtavaryhmat"]
}
