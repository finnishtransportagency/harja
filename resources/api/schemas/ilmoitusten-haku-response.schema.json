{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/ilmoitusten-haku-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ilmoitukset": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ilmoitus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ilmoitusid": {
                "type": "integer"
              },
              "tunniste": {
                "type": "string"
              },
              "tila": {
                "enum": [
                  "kuittaamaton",
                  "vastaanotettu",
                  "aloitettu",
                  "lopetettu",
                  "ei-valitetty"
                ]
              },
              "alueurakkanumero": {
                "type": ["string","integer"]
              },
              "ilmoitettu": {
                "type": "string",
                "format": "date-time"
              },
              "valitetty-harjaan": {
                "type": "string",
                "format": "date-time"
              },
              "valitetty-urakkaan": {
                "type": "string",
                "format": "date-time"
              },
              "vastaanotettu-harjaan": {
                "type": "string",
                "format": "date-time"
              },
              "paivitetty-harjaan": {
                "type": "string",
                "format": "date-time"
              },
              "ilmoitustyyppi": {
                "enum": [
                  "tiedoitus",
                  "toimenpidepyynto",
                  "kysely"
                ]
              },
              "yhteydenottopyynto": {
                "type": "boolean"
              },
              "ilmoittaja": {
                "type": "object",
                "additionalProperties": false,
                "$ref": "file:resources/api/schemas/entities/henkilo-opt.schema.json"
              },
              "lahettaja": {
                "type": "object",
                "additionalProperties": false,
                "$ref": "file:resources/api/schemas/entities/henkilo-opt.schema.json"
              },
              "emon-ilmoitusid": {
                "type": "integer"
              },
              "kuvat": {
                "type": "array",
                "maxItems": 5,
                "additionalProperties": false,
                "items": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "url": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "selitteet": {
                "type": "array",
                "maxItems": 100,
                "additionalProperties": false,
                "items": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "selite": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "aihe": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "nimi": {
                    "type": "string"
                  }
                }
              },
              "tarkenne": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "nimi": {
                    "type": "string"
                  }
                }
              },
              "sijainti": {
                "$ref": "file:resources/api/schemas/entities/sijainti-myos-vanhat-kaistat.schema.json"
              },
              "tienumero": {
                "type": "integer",
                "minimum": 0
              },
              "otsikko": {
                "type": "string"
              },
              "paikankuvaus": {
                "type": "string"
              },
              "lisatieto": {
                "type": "string"
              },
              "aiheutti-toimenpiteita": {
                "type": "boolean"
              },
              "kuittaukset": {
                "type": "array",
                "maxItems": 100,
                "items": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kuittaus": {
                        "type": "object",
                        "additionalProperties": false,
                        "$ref": "file:resources/api/schemas/entities/toimenpidekuittaus.schema.json"
                      }
                    },
                    "required": ["kuittaus"]
                  }
                ]
              }
            },
            "required": [
              "ilmoitusid",
              "tila",
              "ilmoitettu",
              "valitetty-harjaan",
              "valitetty-urakkaan",
              "vastaanotettu-harjaan",
              "ilmoitustyyppi",
              "yhteydenottopyynto",
              "ilmoittaja",
              "lahettaja",
              "sijainti"
            ]
          }
        }
      }
    }
  }
}
