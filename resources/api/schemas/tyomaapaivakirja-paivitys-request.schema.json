{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/tyomaapaivakirja-paivitys-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json"
    },
    "tyomaapaivakirja": {
      "type": "object",
      "additionalProperties": false,
      "extends": [
        {
          "$ref": "file:resources/api/schemas/entities/tyomaapaivakirja-kirjaus.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "urakoitsijan-merkinnat": {
              "type": "object",
              "required": true,
              "description": "Urakoitsijan merkinnät jälkikäteen kun päiväkirja on merkitty valmiiksi.",
              "properties": {
                "kuvaus": {
                  "required": true,
                  "type": "string"
                },
                "nimi": {
                  "required": true,
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": ["otsikko"]
}
