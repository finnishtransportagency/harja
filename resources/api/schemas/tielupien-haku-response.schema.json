{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harja/tielupien-haku-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tieluvat": {
      "type": "array",
      "maxItems" : 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tielupa": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "diaarinumero": {
                "type": "integer"
              },
              "tielupatyyppi": {
                "enum": [
                  "kaapelien-johtojen-ja-putkien-sijoituslupa",
                  "opasteet-ja-mainoslupa",
                  "liittymalupa",
                  "tiealueella-tyoskentely-lupa",
                  "ajoneuvosiirtolupa",
                  "vahingonkorvaukset"
                ]
              },
              "otsikko": {
                "type": "string"
              },
              "myonnetty": {
                "type": "string",
                "format": "date-time"
              },
              "voimassa": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "alkaen": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "paattyen": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "sijainti": {
                "$ref": "file:resources/api/schemas/entities/sijainti-myos-vanhat-kaistat.schema.json"
              }
            },
            "required": ["diaarinumero", "myonnetty", "voimassa", "sijainti"]
          }
        }
      }
    }
  }
}
