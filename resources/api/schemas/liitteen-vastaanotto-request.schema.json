{
  "$schema": "http://json-schema.org/draft-03/schema#",
  "id": "urn:harja/liitteen-vastaanotto-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "otsikko": {
      "id": "urn:harja/otsikko",
      "type": "object",
      "additionalProperties": false,
      "$ref": "file:resources/api/schemas/entities/otsikko.schema.json",
      "required": true
    },
    "liite": {
      "id": "urn:harja/liite",
      "type": "object",
      "additionalProperties": false,
      "required": true,
      "properties": {
        "kategoria": {
          "id": "urn:harja/liite/kategoria",
          "type": "string",
          "enum": [
            "siltatarkastus"
          ],
          "description": "Liitteen kohdeluokka. Palvelin hyväksyy vain tuetut kategoriat.",
          "required": true
        },
        "tunniste": {
          "id": "urn:harja/liite/tunniste",
          "type": "object",
          "additionalProperties": false,
          "description": "Kategorian mukaiset tunnisteet aiemmin lähetetyn tiedon löytämiseksi.",
          "required": true,
          "properties": {
            "siltatarkastus": {
              "id": "urn:harja/liite/tunniste/siltatarkastus",
              "type": "object",
              "additionalProperties": false,
              "$ref": "file:resources/api/schemas/entities/tunniste.schema.json",
              "required": true
            },
            "siltatarkastuskohde": {
              "id": "urn:harja/liite/tunniste/siltatarkastuskohde",
              "type": "string",
              "minLength": 1,
              "required": true
            }
          }
        },
        "tiedosto": {
          "id": "urn:harja/liite/tiedosto",
          "type": "object",
          "additionalProperties": false,
          "required": true,
          "properties": {
            "nimi": {
              "id": "urn:harja/liite/tiedosto/nimi",
              "type": "string",
              "required": true
            },
            "tyyppi": {
              "id": "urn:harja/liite/tiedosto/tyyppi",
              "type": "string",
              "required": true
            },
            "kuvaus": {
              "id": "urn:harja/liite/tiedosto/kuvaus",
              "type": "string"
            },
            "sisalto": {
              "id": "urn:harja/liite/tiedosto/sisalto",
              "type": "string",
              "required": true
            }
          }
        }
      }
    }
  }
}
