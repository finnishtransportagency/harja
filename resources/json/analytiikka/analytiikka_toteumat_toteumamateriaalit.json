        "Hiekoitushiekka, liukkaudentorjunta"
      ]
    },
    "f3": {
      "$id": "#/properties/f3",
      "type": "number",
      "title": "Raportoidun materiaalin määrä",
      "description": "Raportoidun materiaalin nimi. Viittaa MATERIAALI_TOTEUMA.maara-sarakkeeseen.",
