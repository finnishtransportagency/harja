{:id :pilotti-kustannussuunnitelma
 :nimi "Pilotti: kustannussuunnitelma"
 :kuvaus "Pitkät kustannusosiot, kuukausisarakkeet, useat taulukkovaiheet, varoitukset ja yhteenvetorivit."
 :pilottisivu {:tyyppi :yhteenveto
               :lahde "src/cljs/harja/views/urakka/suunnittelu/tarjous_kustannussuunnitelma/kustannussuunnitelma_nakyma.cljs"
               :less "dev-resources/less/pages/kustannussuunnitelma.less"}
 :puu [{:komponentti :sailio
        :asetukset {:leveys :suuri
                    :sisareuna :pieni
                    :data-cy "pilotti-kustannussuunnitelma-sailio"}
        :lapset [{:komponentti :osio
                  :asetukset {:otsikko "Kustannussuunnitelma 2026"
                              :otsikkotaso 1
                              :vali :pieni
                              :data-cy "pilotti-kustannussuunnitelma-otsikko"}
                  :lapset [{:komponentti :info-laatikko
                            :asetukset {:tyyppi :varoitus
                                        :ensisijainen-viesti "Tavoitehinnan arvio ylittää laskutusrajan."
                                        :toissijainen-viesti "Muutos perustuu Q4-ennusteeseen ja vaatii hyväksynnän."}}
                           {:komponentti :kortti
                            :asetukset {:data-cy "pilotti-kustannussuunnitelma-tehtavat-kortti"
                                        :otsikko "Suunnitellut tehtävät"
                                        :otsikkotaso 2}
                            :lapset [{:komponentti :perusgrid
                                      :asetukset {:tunniste :id
                                                  :tyhja "Ei suunniteltuja tehtäviä."
                                                  :sarakkeet [{:otsikko "Toimenpide" :nimi :toimenpide :leveys 6}
                                                              {:otsikko "Lokakuu" :nimi :lokakuu :leveys 2}
                                                              {:otsikko "Marraskuu" :nimi :marraskuu :leveys 2}
                                                              {:otsikko "Joulukuu" :nimi :joulukuu :leveys 2}
                                                              {:otsikko "Tammikuu" :nimi :tammikuu :leveys 2}
                                                              {:otsikko "Helmikuu" :nimi :helmikuu :leveys 2}]
                                                  :rivit [{:id 1 :toimenpide "Auraus" :lokakuu "45 000 €" :marraskuu "78 000 €" :joulukuu "92 000 €" :tammikuu "85 000 €" :helmikuu "74 000 €"}
                                                          {:id 2 :toimenpide "Liukkaudentorjunta" :lokakuu "28 000 €" :marraskuu "46 000 €" :joulukuu "61 000 €" :tammikuu "58 000 €" :helmikuu "51 000 €"}
                                                          {:id 3 :toimenpide "Liikenneympäristön hoito" :lokakuu "18 000 €" :marraskuu "12 000 €" :joulukuu "8 000 €" :tammikuu "7 000 €" :helmikuu "9 000 €"}
                                                          {:id :yhteensa :rivityyppi :yhteenveto :toimenpide "Yhteensä" :lokakuu "91 000 €" :marraskuu "136 000 €" :joulukuu "161 000 €" :tammikuu "150 000 €" :helmikuu "134 000 €"}]}}]}
                           {:komponentti :kortti
                            :asetukset {:data-cy "pilotti-kustannussuunnitelma-tavoitehinta-kortti"
                                        :otsikko "Tavoitehinta ja rajat"
                                        :otsikkotaso 2}
                            :lapset [{:komponentti :tietolista
                                      :asetukset {:rivit [{:otsikko "Tavoitehinta" :arvo "4 860 000 €"}
                                                          {:otsikko "Pysyvät muutokset" :arvo "86 500 €"}
                                                          {:otsikko "Indeksikorjattu tavoitehinta" :arvo "4 946 500 €"}
                                                          {:otsikko "Laskutusraja" :arvo "5 020 000 €"}
                                                          {:otsikko "Ero laskutusrajaan" :arvo "73 500 €"}]}}
                                     {:komponentti :perusgrid
                                      :asetukset {:tunniste :id
                                                  :tyhja "Ei kustannuseriä."
                                                  :sarakkeet [{:otsikko "Erä" :nimi :era :leveys 5}
                                                              {:otsikko "Peruste" :nimi :peruste :leveys 7}
                                                              {:otsikko "Tila" :nimi :tila :leveys 3 :solu :tila-indikaattori}]
                                                  :rivit [{:id 1 :era "Q4 ennuste" :peruste "Talvihoidon toteumamalli" :tila "käsittelyssä"}
                                                          {:id 2 :era "Indeksikorjaus" :peruste "Sopimuskauden indeksi" :tila "valmis"}]}}]}
                           {:komponentti :toimintoryhma
                            :asetukset {:data-cy "pilotti-kustannussuunnitelma-toiminnot"}
                            :lapset [{:komponentti :nappi
                                      :asetukset {:teksti "Palaa yhteenvetoon"
                                                  :variantti :toissijainen}}
                                     {:komponentti :nappi
                                      :asetukset {:teksti "Tallenna suunnitelma"
                                                  :variantti :ensisijainen}}]}]}]}]}
