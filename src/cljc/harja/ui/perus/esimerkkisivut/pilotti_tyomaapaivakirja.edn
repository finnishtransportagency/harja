{:id :pilotti-tyomaapaivakirja
 :nimi "Pilotti: työmaapäiväkirja"
 :kuvaus "Pitkä listaus- ja detailnäkymä, sivutettu muutoshistoria, kommentit sekä alareunan toimintopalkki."
 :pilottisivu {:tyyppi :asiakirja
               :lahde "src/cljs/harja/views/urakka/tyomaapaivakirja/paivakirja.cljs"
               :less "dev-resources/less/pages/tyomaapaivakirja.less"}
 :puu [{:komponentti :sailio
        :asetukset {:leveys :suuri
                    :sisareuna :pieni
                    :data-cy "pilotti-tyomaapaivakirja-sailio"}
        :lapset [{:komponentti :osio
                  :asetukset {:otsikko "Työmaapäiväkirjat"
                              :otsikkotaso 1
                              :vali :pieni
                              :data-cy "pilotti-tyomaapaivakirja-otsikko"}
                  :lapset [{:komponentti :suodatinrivi
                            :asetukset {:data-cy "pilotti-tyomaapaivakirja-suodattimet"}
                            :lapset [{:komponentti :livi-pudotusvalikko
                                      :asetukset {:otsikko "Kuukausi"
                                                  :valinnat ["Lokakuu 2026" "Marraskuu 2026"]
                                                  :optiot {:data-cy "pilotti-tyomaapaivakirja-kuukausi"}}}
                                     {:komponentti :nappi
                                      :asetukset {:teksti "Hae"
                                                  :variantti :ensisijainen}}]}
                           {:komponentti :kortti
                            :asetukset {:data-cy "pilotti-tyomaapaivakirja-paivakirjat-kortti"
                                        :otsikko "Päiväkirjat"
                                        :otsikkotaso 2}
                            :lapset [{:komponentti :perusgrid
                                      :asetukset {:tunniste :id
                                                  :sivuta 4
                                                  :tyhja "Ei työmaapäiväkirjoja."
                                                  :sarakkeet [{:otsikko "Päivä" :nimi :pvm :leveys 2}
                                                              {:otsikko "Työmaa" :nimi :tyomaa :leveys 4 :solu :linkki}
                                                              {:otsikko "Työnjohtaja" :nimi :tyonjohtaja :leveys 3}
                                                              {:otsikko "Havaintoja" :nimi :havaintoja :leveys 2}
                                                              {:otsikko "Tila" :nimi :tila :leveys 2 :solu :tila-indikaattori}]
                                                  :rivit [{:id 1 :pvm "26.11.2026" :tyomaa "KT 4 Rovaniemi" :tyonjohtaja "Työmaa 1" :havaintoja 3 :tila "käsittelyssä"}
                                                          {:id 2 :pvm "25.11.2026" :tyomaa "VT 20 Kuusamo" :tyonjohtaja "Työmaa 2" :havaintoja 1 :tila "valmis"}
                                                          {:id 3 :pvm "24.11.2026" :tyomaa "KT 20 Oulu" :tyonjohtaja "Työmaa 1" :havaintoja 0 :tila "valmis"}
                                                          {:id 4 :pvm "23.11.2026" :tyomaa "VT 5 Kajaani" :tyonjohtaja "Työmaa 3" :havaintoja 2 :tila "valmis"}
                                                          {:id 5 :pvm "22.11.2026" :tyomaa "KT 78 Kokkola" :tyonjohtaja "Työmaa 4" :havaintoja 1 :tila "valmis"}
                                                          {:id 6 :pvm "21.11.2026" :tyomaa "VT 29 Tornio" :tyonjohtaja "Työmaa 5" :havaintoja 0 :tila "valmis"}]}}]}
                           {:komponentti :kortti
                            :asetukset {:data-cy "pilotti-tyomaapaivakirja-detalji-kortti"
                                        :otsikko "26.11.2026 – KT 4 Rovaniemi"
                                        :otsikkotaso 2}
                            :lapset [{:komponentti :tietolista
                                      :asetukset {:rivit [{:otsikko "Työnjohtaja" :arvo "Työmaa 1"}
                                                          {:otsikko "Sää" :arvo "−6 °C, lumisade 18 cm"}
                                                          {:otsikko "Raportti" :arvo "Auraus valmistui suunnitellusti. Hiontaa jatkettiin mutkissa 3–8, ja rajakohdissa havaittiin kaksi lyhyttä liukkausjaksoa."}
                                                          {:otsikko "Kommentit" :arvo "Urakoitsija: Kelien vuoksi yövuoro vahvistettiin kahdella koneella. Tilaaja kuittaa seurannan jatkumisen aamulla."}]}}
                                     {:komponentti :info-laatikko
                                      :asetukset {:tyyppi :neutraali
                                                  :ensisijainen-viesti "Muutoshistoria"
                                                  :toissijainen-viesti "25.11. klo 16.40: kommentti lisätty. 26.11. klo 06.15: sää- ja työtiedot päivitetty."}}]}
                           {:komponentti :toimintoryhma
                            :asetukset {:data-cy "pilotti-tyomaapaivakirja-toiminnot"}
                            :lapset [{:komponentti :nappi
                                      :asetukset {:teksti "Sulje"
                                                  :variantti :toissijainen}}
                                     {:komponentti :nappi
                                      :asetukset {:teksti "Lähetä tiedoksi"
                                                  :variantti :ensisijainen}}]}]}]}]}
